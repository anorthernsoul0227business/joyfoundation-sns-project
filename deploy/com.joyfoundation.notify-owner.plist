<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.joyfoundation.notify-owner</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/kitakoujirou/agent/loop/notify_owner.py</string>
    </array>

    <!-- 月曜の朝9時。週に一度見ていただく前提でお願いしているので、それに合わせる。
         毎日送ると受信箱が埋まり、かえって読まれなくなる。
         確認するものが1件も無ければ送らないようにしてある -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>WorkingDirectory</key>
    <string>/Users/kitakoujirou/agent/loop</string>

    <key>StandardOutPath</key>
    <string>/Users/kitakoujirou/agent/loop/logs/notify_owner_out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/kitakoujirou/agent/loop/logs/notify_owner_err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/kitakoujirou/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/kitakoujirou</string>
    </dict>
</dict>
</plist>
