# ============================================================
# SNS投稿通知設定（.envに追加してください）
# ============================================================

# 通知の有効化（false にすれば一時停止）
NOTIFY_ENABLED=true

# Gmail通知設定
# 1. https://myaccount.google.com/security で「2段階認証プロセス」を有効化
# 2. https://myaccount.google.com/apppasswords で「アプリパスワード」を生成
#    - アプリ名: "Claude SNS Poster" など任意
#    - 16桁のパスワード（スペースあり）が発行される
# 3. 下記に貼り付け（スペースは削除してもOK）
NOTIFY_GMAIL_USER=a.northern.soul.0227@gmail.com
NOTIFY_GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
NOTIFY_GMAIL_TO=a.northern.soul.0227@gmail.com

# 複数宛先にする場合はカンマ区切り
# NOTIFY_GMAIL_TO=a.northern.soul.0227@gmail.com,kita@h-garden.com

# ============================================================
# X投稿URLの組み立て用（通知メールに投稿リンクを含める際に使用）
# ============================================================
X_USERNAME=SFH_Science
