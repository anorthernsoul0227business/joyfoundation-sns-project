# Next.js Web アプリの環境変数テンプレート
# このファイルをコピーして `.env.local` を作成してください: cp .env.example .env.local

# FastAPI バックエンドのベースURL
# - ローカル開発: http://localhost:8000
# - 本番 (Cloud Run): https://<cloud-run-url>
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase Realtime (notifications 購読) — ARCH-003
# - Dashboard → Project Settings → API → Project URL / Public anon key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
