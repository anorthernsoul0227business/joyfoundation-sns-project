# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# FastAPI
APP_NAME=sns-calendar-api
FRONTEND_URL=

# OAuth providers
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
META_APP_ID=
META_APP_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8000

# 投稿結果メール通知 (WEB-023)
# 未設定時は notify_post_result が no-op となり送信されません
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# Cloudflare R2 (画像アップロード WEB-024)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Google Drive 画像ピッカー
# サービスアカウント資格情報: 本番は JSON 文字列(_JSON)、ローカルはファイルパス(_FILE)を使う
# 事前作業: 共有フォルダを SA のメールアドレスに閲覧者として共有 + GCP で Drive API 有効化
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
DRIVE_SHARED_FOLDER_ID=
